{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netlume",
  "version": "0.1.0",
  "identifier": "com.szymonjankiewicz.netlume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Netlume",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
