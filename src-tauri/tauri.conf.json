{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netlume",
  "version": "0.1.0",
  "identifier": "com.szymonjankiewicz.netlume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Netlume",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "windivert/WinDivert.dll": "WinDivert.dll",
      "windivert/WinDivert64.sys": "WinDivert64.sys",
      "windivert/LICENSE": "WinDivert-LICENSE.txt",
      "../THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
